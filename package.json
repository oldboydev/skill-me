{
  "name": "skill-me",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:governance && npm run test:code-review && npm run test:doctor",
    "review:run": "node scripts/code-review/cli.mjs review",
    "review:check": "node scripts/code-review/cli.mjs check",
    "pr:create": "node scripts/code-review/cli.mjs pr",
    "test:code-review": "node --test scripts/code-review/review.test.mjs",
    "test:governance": "node --test scripts/governance-ci.test.mjs",
    "test:doctor": "node --test \"tests/doctor/**/*.test.mjs\"",
    "doctor": "node src/doctor/cli.mjs"
  },
  "devDependencies": {
    "yaml": "2.9.0"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  }
}
